# Copy this file to .env and fill in the values. Never commit your real .env.
# These are variable NAMES only — every value below is a placeholder.

# ── Database — PostgreSQL (Neon) ────────────────────────────────────────────
# Pooled connection string from your Neon project (used by Prisma).
# DATABASE_URL="postgresql://user:password@host/dbname"
DATABASE_URL=

# ── Auth.js v5 (next-auth) ──────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET="generate-with-node-crypto-randombytes"
AUTH_SECRET=

# Canonical app URL. Locally: http://localhost:3000 (optional in dev, set in prod).
# AUTH_URL="http://localhost:3000"
AUTH_URL=

# Google OAuth 2.0 client credentials from Google Cloud Console.
# AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_ID=

# AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_GOOGLE_SECRET=

# ── Sign-in allow-list ──────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in with Google (guest demo bypasses this).
# Example: alice@example.com,bob@example.com
# ALLOWED_EMAILS="email1@example.com,email2@example.com"
ALLOWED_EMAILS=

# ── AI summaries — Google Gemini ────────────────────────────────────────────
# API key for the Gemini model that narrates risk summaries.
# GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY=
